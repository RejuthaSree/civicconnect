{
  "info": {
    "name": "CivicConnect Razorpay Payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" },
    { "key": "bookingId", "value": "1" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Razorpay order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"amount\": 750.00,\n  \"paymentSource\": \"CITIZEN\"\n}"
        },
        "url": "{{baseUrl}}/api/payments/create-order"
      }
    },
    {
      "name": "Verify Razorpay payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razorpay_order_id\": \"{{orderId}}\",\n  \"razorpay_payment_id\": \"pay_example\",\n  \"razorpay_signature\": \"signature-from-razorpay\"\n}"
        },
        "url": "{{baseUrl}}/api/payments/verify"
      }
    },
    {
      "name": "Payment history",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwt}}" } ],
        "url": "{{baseUrl}}/api/payments/history"
      }
    }
  ]
}
